{
  "adafruit_io": {
    "username": "YOUR_AIO_USERNAME",
    "key": "YOUR_AIO_KEY",
    "host": "io.adafruit.com",
    "port": 8883,
    "use_tls": true,
    "feeds": {
      "motion": "sensor.motion",
      "temperature": "sensor.temperature",
      "humidity": "sensor.humidity"
    }
  },
  "pins": {
    "led_bcm": 17,
    "beeper_bcm": 27,
    "servo_bcm": 22,
    "dht_bcm": "D4",
    "pir_bcm": 23
  },
  "camera": {
    "device_index": 0,
    "width": 1280,
    "height": 720
  },
  "logic": {
    "read_interval_seconds": 5,
    "motion_alarm_seconds": 3,
    "pir_debounce_seconds": 1.0
  }
}